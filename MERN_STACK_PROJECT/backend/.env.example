# MongoDB Connection URI
# Example: mongodb://localhost:27017/mern_app
# Or for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/mern_app
MONGO_URI=mongodb://localhost:27017/mern_app

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
# Secret key for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Optional: JWT Expiration (default is 7 days)
JWT_EXPIRE=7d
